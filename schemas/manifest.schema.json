{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ras-report.example/schemas/manifest.schema.json",
  "title": "RAS Report Manifest",
  "type": "object",
  "required": ["schema_version", "report_id", "title", "request", "style_decision", "blocks", "outputs"],
  "properties": {
    "schema_version": { "const": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "request": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "audience": { "type": "string" }, "overrides": { "type": "object" } } },
    "style_decision": { "$ref": "brand.schema.json#/definitions/styleDecision" },
    "design": { "$ref": "brand.schema.json#/definitions/designRequest" },
    "content_plan": { "type": "object", "properties": { "profile": { "enum": ["quick", "standard", "deep"] }, "target_pages": { "type": "integer", "minimum": 1, "maximum": 100 }, "page_range": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 }, "target_words": { "type": "integer", "minimum": 1 }, "word_range": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 }, "target_slides": { "type": "integer", "minimum": 1 }, "sections": { "type": "array" } }, "additionalProperties": true },
    "research": { "type": "object", "properties": { "mode": { "enum": ["none", "provided", "web"] }, "performed": { "type": "boolean" }, "authorized": { "type": "boolean" }, "notes": { "type": "string" } }, "additionalProperties": true },
    "blocks": { "type": "array", "items": { "$ref": "block.schema.json" } },
    "outputs": { "type": "object", "required": ["formats"], "properties": { "directory": { "type": "string" }, "filename": { "type": "string" }, "formats": { "type": "array", "items": { "enum": ["docx", "pdf", "pptx"] }, "minItems": 1 } } }
  }
}
